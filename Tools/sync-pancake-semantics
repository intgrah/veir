#!/usr/bin/env python3
"""Check (or --write) the pinned Flapjack scalar semantics snapshot."""

import argparse
from pathlib import Path
import re
import subprocess

REVISION = "65fb1aa2d846adc590677994ccf92821fc9781e7"
ROOT = Path(__file__).resolve().parent.parent
OUTPUT = ROOT / "Veir/Dialects/Pancake/Flapjack.lean"


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("checkout", type=Path, help="local Flapjack Git checkout")
    parser.add_argument("--write", action="store_true", help="regenerate instead of checking")
    args = parser.parse_args()

    def source(path):
        return subprocess.check_output(
            ["git", "-C", str(args.checkout), "show", f"{REVISION}:{path}"], text=True
        )

    def declaration(path, name):
        text = source(path)
        match = re.search(rf"^(?:def|inductive|abbrev) {re.escape(name)}\b", text, re.M)
        if match is None:
            raise SystemExit(f"missing declaration {name} in {path}")
        # These selected declarations have no internal blank lines. Keep their
        # signatures and bodies byte-for-byte; omit upstream imports and @[hol] tags.
        return text[match.start():].split("\n\n", 1)[0].rstrip() + "\n"

    panlang = "Flapjack/Pancake/PanLang.lean"
    wordlang = "Flapjack/Pancake/WordLang.lean"
    asm = "Flapjack/Compiler/Encoders/Asm.lean"
    pansem = "Flapjack/Pancake/Semantics/PanSemStateEval.lean"
    pieces = [
        "module\n\npublic import Init\n\n/-\n" + source("LICENSE").rstrip() + "\n-/\n",
        f"""/-!
Generated by `Tools/sync-pancake-semantics`; do not edit by hand.
Source: https://github.com/flamingoponderado/flapjack/tree/{REVISION}

Unmodified declarations used by Flapjack's exact Pancake expression evaluator:
`wordOpHOL`, `panOpHOL`, and `wordCmpHOL`, with their dependencies. Only the
imports, source-reference attributes, and enclosing namespace are replaced.
The original bodies are checked against the pinned Git objects by the script.
This snapshot avoids importing unrelated compiler modules incompatible with
VeIR's Lean version. It is not the complete Flapjack expression evaluator.
-/

namespace Veir.PancakeSource

public section
""",
    ]
    for name in ("BinOp", "PanOp", "Cmp"):
        pieces.append(f"-- {panlang}\n" + declaration(panlang, name))
    pieces += ["namespace RiscV\n", declaration("Flapjack/RiscV/Model.lean", "Word"), "end RiscV\n"]
    for path, names in ((wordlang, ("wordOp", "wordOpHOL")), (pansem, ("panOpHOL",))):
        for name in names:
            pieces.append(f"-- {path}\n" + declaration(path, name))
    pieces.append("namespace Compiler.Encoders.Asm\n")
    for name in ("holAsmSignedLess", "wordCmpHOL", "wordCmpResultHOL"):
        pieces.append(f"-- {asm}\n" + declaration(asm, name))
    pieces.append("end Compiler.Encoders.Asm\n\nend\n\nend Veir.PancakeSource\n")
    generated = "\n".join(pieces)
    if args.write:
        OUTPUT.write_text(generated)
    elif not OUTPUT.exists() or OUTPUT.read_text() != generated:
        raise SystemExit("Flapjack snapshot differs; inspect the diff before regenerating with --write")
    print(f"Flapjack scalar declarations match {REVISION}")


if __name__ == "__main__":
    main()
