#!/usr/bin/env python3
"""Check (or --write) the pinned Flapjack scalar semantics snapshot."""

import argparse
from pathlib import Path
import re
import subprocess

REVISION = "65fb1aa2d846adc590677994ccf92821fc9781e7"
ROOT = Path(__file__).resolve().parent.parent
OUTPUT = ROOT / "Veir/Dialects/Pancake/Flapjack.lean"
EXPR_OUTPUT = ROOT / "Veir/Dialects/Pancake/FlapjackExpr.lean"


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("checkout", type=Path, help="local Flapjack Git checkout")
    parser.add_argument("--write", action="store_true", help="regenerate instead of checking")
    args = parser.parse_args()

    def source(path):
        return subprocess.check_output(
            ["git", "-C", str(args.checkout), "show", f"{REVISION}:{path}"], text=True
        )

    def declaration(path, name):
        text = source(path)
        match = re.search(rf"^(?:def|inductive|abbrev) {re.escape(name)}\b", text, re.M)
        if match is None:
            raise SystemExit(f"missing declaration {name} in {path}")
        # These selected declarations have no internal blank lines. Keep their
        # signatures and bodies byte-for-byte; omit upstream imports and @[hol] tags.
        return text[match.start():].split("\n\n", 1)[0].rstrip() + "\n"

    panlang = "Flapjack/Pancake/PanLang.lean"
    wordlang = "Flapjack/Pancake/WordLang.lean"
    asm = "Flapjack/Compiler/Encoders/Asm.lean"
    pansem = "Flapjack/Pancake/Semantics/PanSemStateEval.lean"
    pieces = [
        "module\n\npublic import Init\n\n/-\n" + source("LICENSE").rstrip() + "\n-/\n",
        f"""/-!
Generated by `Tools/sync-pancake-semantics`; do not edit by hand.
Source: https://github.com/flamingoponderado/flapjack/tree/{REVISION}

Unmodified declarations used by Flapjack's exact Pancake expression evaluator:
`wordOpHOL`, `panOpHOL`, and `wordCmpHOL`, with their dependencies. Only the
imports, source-reference attributes, and enclosing namespace are replaced.
The original bodies are checked against the pinned Git objects by the script.
This snapshot avoids importing unrelated compiler modules incompatible with
VeIR's Lean version. It is not the complete Flapjack expression evaluator.
-/

namespace Veir.PancakeSource

public section
""",
    ]
    for name in ("BinOp", "PanOp", "Cmp"):
        pieces.append(f"-- {panlang}\n" + declaration(panlang, name))
    pieces += ["namespace RiscV\n", declaration("Flapjack/RiscV/Model.lean", "Word"), "end RiscV\n"]
    for path, names in ((wordlang, ("wordOp", "wordOpHOL")), (pansem, ("panOpHOL",))):
        for name in names:
            pieces.append(f"-- {path}\n" + declaration(path, name))
    pieces.append("namespace Compiler.Encoders.Asm\n")
    for name in ("holAsmSignedLess", "wordCmpHOL", "wordCmpResultHOL"):
        pieces.append(f"-- {asm}\n" + declaration(asm, name))
    pieces.append("end Compiler.Encoders.Asm\n\nend\n\nend Veir.PancakeSource\n")
    generated = "\n".join(pieces)

    # The expression carrier is copied in full. The evaluator is explicitly a
    # scalar projection: retain these clauses verbatim (apart from namespaces /
    # recursive function names), replace all other clauses by failure, and keep
    # only the two state fields those clauses read. Do not call this evalHOLExact.
    expr = ["""module

public import Veir.Dialects.Pancake.Flapjack

/-!
Generated by `Tools/sync-pancake-semantics` from the same pinned Flapjack revision
as `Flapjack.lean`; its BSD license applies here too.

The expression/value/name datatypes are copied in full. `evalScalarHOL` is a
PROJECTION of `PanSem/EvalExact.lean`, not the full evaluator: only const, var,
op, panop, cmp and the expression-list clauses are retained. Other constructors
return none, and ScalarState contains only locals/globals. Retained clause
bodies are source-checked by the generator, with namespace/function renaming.
The frontend theorem is about this projection and the emitted SSA instruction
sequence. It does not certify the source extractor, textual serialization,
VeIR's parser, or execution of stateful Pancake programs.
-/

namespace Veir.PancakeSource
public section
"""]
    for path, names in (
        ("Flapjack/Basis/Pure/MlString.lean", ("HolChar", "MlString")),
        (panlang, ("VarKind",)),
        ("Flapjack/AstHOL.lean", ("Shift",)),
    ):
        for name in names:
            expr.append(f"-- {path}\n" + declaration(path, name))
    expr.append("abbrev MlS := MlString\nabbrev MlStringHOL := MlString\n")
    for path, names in (
        ("Flapjack/Pancake/PanLang/Shape.lean", ("ShapeHOL",)),
        ("Flapjack/Pancake/PanLang/Exp.lean", ("ExpHOL",)),
        ("Flapjack/Pancake/Semantics/PanSem.lean", ("HolWordLab",)),
        ("Flapjack/Pancake/Semantics/PanSem/ValueHOL.lean", ("ValueHOL",)),
        ("Flapjack/Pancake/Semantics/PanSem/EvalExact.lean", ("valueIsWord", "valueWord")),
    ):
        for name in names:
            expr.append(f"-- {path}\n" + declaration(path, name))
    expr.append("""structure ScalarState (width : Nat) [NeZero width] where
  locals : MlS → Option (ValueHOL width)
  globals : MlS → Option (ValueHOL width)

mutual
  def evalScalarHOL {width : Nat} [NeZero width] (state : ScalarState width) :
      ExpHOL width → Option (ValueHOL width)
""")
    evaluator = source("Flapjack/Pancake/Semantics/PanSem/EvalExact.lean")
    clauses = evaluator.split("    | .const value =>", 1)[1].split(
        "  /-- Untagged exact port of the `OPT_MMAP eval` list step. -/", 1)[0]
    clauses = "    | .const value =>" + clauses
    for clause in re.split(r"(?=^    \| \.)", clauses, flags=re.M):
        if re.match(r"    \| \.(const|var|op|panop|cmp)\b", clause):
            expr.append(clause.rstrip() + "\n")
    expr.append("    | _ => none\n")
    list_body = evaluator.split("      List (ExpHOL width) → Option (List (ValueHOL width))\n", 1)[1].split("\n\n", 1)[0]
    expr.append("""  def evalListScalarHOL {width : Nat} [NeZero width] (state : ScalarState width) :
      List (ExpHOL width) → Option (List (ValueHOL width))
""" + list_body + "\nend\n\nend\nend Veir.PancakeSource\n")
    expressions = "\n".join(expr).replace("evalListHOLExact", "evalListScalarHOL").replace(
        "evalHOLExact state", "evalScalarHOL state").replace(
        "Flapjack.Compiler.Encoders.Asm.wordCmpHOL", "Compiler.Encoders.Asm.wordCmpHOL")
    for output, contents in ((OUTPUT, generated), (EXPR_OUTPUT, expressions)):
        if args.write:
            output.write_text(contents)
        elif not output.exists() or output.read_text() != contents:
            raise SystemExit(f"{output.name} differs; inspect before regenerating with --write")
    print(f"Flapjack scalar declarations match {REVISION}")


if __name__ == "__main__":
    main()
