module

public import Veir.Dialects.Pancake.Flapjack

/-!
Generated by `Tools/sync-pancake-semantics` from the same pinned Flapjack revision
as `Flapjack.lean`; its BSD license applies here too.

The expression/value/name datatypes are copied in full. `evalScalarHOL` is a
PROJECTION of `PanSem/EvalExact.lean`, not the full evaluator: only const, var,
op, panop, cmp and the expression-list clauses are retained. Other constructors
return none, and ScalarState contains only locals/globals. Retained clause
bodies are source-checked by the generator, with namespace/function renaming.
The frontend theorem is about this projection and the emitted SSA instruction
sequence. It does not certify the source extractor, textual serialization,
VeIR's parser, or execution of stateful Pancake programs.
-/

namespace Veir.PancakeSource
public section

-- Flapjack/Basis/Pure/MlString.lean
abbrev HolChar := BitVec 8

-- Flapjack/Basis/Pure/MlString.lean
inductive MlString where
  | implode (data : List HolChar)
  deriving Repr, DecidableEq

-- Flapjack/Pancake/PanLang.lean
inductive VarKind where
  | local
  | global
  deriving DecidableEq, Repr

-- Flapjack/AstHOL.lean
inductive Shift where
  | lsl
  | lsr
  | asr
  | ror
  deriving DecidableEq, Repr

abbrev MlS := MlString
abbrev MlStringHOL := MlString

-- Flapjack/Pancake/PanLang/Shape.lean
inductive ShapeHOL where
  | one
  | comb (fields : List ShapeHOL)
  | named (name : MlS)
  deriving Repr

-- Flapjack/Pancake/PanLang/Exp.lean
inductive ExpHOL (width : Nat) [NeZero width] where
  | const (value : BitVec width)
  | var (kind : VarKind) (name : MlS)
  | rstruct (fields : List (ExpHOL width))
  | rfield (index : Nat) (value : ExpHOL width)
  | nstruct (name : MlS) (fields : List (MlS × ExpHOL width))
  | nfield (name : MlS) (value : ExpHOL width)
  | load (shape : ShapeHOL) (address : ExpHOL width)
  | load32 (address : ExpHOL width)
  | loadByte (address : ExpHOL width)
  | op (operator : BinOp) (args : List (ExpHOL width))
  | panop (operator : PanOp) (args : List (ExpHOL width))
  | cmp (operator : Cmp) (left right : ExpHOL width)
  | shift (operator : Shift) (left right : ExpHOL width)
  | baseAddr
  | topAddr
  | bytesInWord
  deriving Repr

-- Flapjack/Pancake/Semantics/PanSem.lean
inductive HolWordLab (width : Nat) [NeZero width] where
  | word (value : BitVec width)
  deriving BEq, DecidableEq, Repr

-- Flapjack/Pancake/Semantics/PanSem/ValueHOL.lean
inductive ValueHOL (width : Nat) [NeZero width] where
  | val (value : HolWordLab width)
  | rStruct (fields : List (ValueHOL width))
  | nStruct (name : MlStringHOL) (fields : List (MlStringHOL × ValueHOL width))
  deriving Repr

-- Flapjack/Pancake/Semantics/PanSem/EvalExact.lean
def valueIsWord {width : Nat} [NeZero width] : ValueHOL width → Bool
  | .val (.word _) => true
  | _ => false

-- Flapjack/Pancake/Semantics/PanSem/EvalExact.lean
def valueWord {width : Nat} [NeZero width] : ValueHOL width → BitVec width
  | .val (.word value) => value
  | _ => 0

structure ScalarState (width : Nat) [NeZero width] where
  locals : MlS → Option (ValueHOL width)
  globals : MlS → Option (ValueHOL width)

mutual
  def evalScalarHOL {width : Nat} [NeZero width] (state : ScalarState width) :
      ExpHOL width → Option (ValueHOL width)

    | .const value => some (.val (.word value))

    | .var kind name =>
        match kind with
        | .local => state.locals name
        | .global => state.globals name

    | .op operator arguments =>
        match evalListScalarHOL state arguments with
        | some values =>
            if values.all valueIsWord then
              (wordOpHOL operator (values.map valueWord)).map
                (fun word => .val (.word word))
            else none
        | none => none

    | .panop operator arguments =>
        match evalListScalarHOL state arguments with
        | some values =>
            if values.all valueIsWord then
              (panOpHOL operator (values.map valueWord)).map
                (fun word => .val (.word word))
            else none
        | none => none

    | .cmp operator left right =>
        match evalScalarHOL state left, evalScalarHOL state right with
        | some (.val (.word leftWord)), some (.val (.word rightWord)) =>
            some (.val (.word
              (if Compiler.Encoders.Asm.wordCmpHOL operator leftWord rightWord
               then 1 else 0)))
        | _, _ => none

    | _ => none

  def evalListScalarHOL {width : Nat} [NeZero width] (state : ScalarState width) :
      List (ExpHOL width) → Option (List (ValueHOL width))
    | [] => some []
    | expression :: rest =>
        match evalScalarHOL state expression, evalListScalarHOL state rest with
        | some value, some values => some (value :: values)
        | _, _ => none
end

end
end Veir.PancakeSource
